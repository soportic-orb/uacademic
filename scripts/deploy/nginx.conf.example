# UAcademic behind Nginx (Plesk / CloudPanel).
#
# Two things this file is responsible for, beyond routing: the SPA must never
# be cached at a stale version, and the API must be reachable at /api on the
# same origin so the session cookie is first-party.
#
# Copy into the vhost's "Additional nginx directives" (Plesk) or the site's
# configuration (CloudPanel), and adjust the paths and the server name.

server {
    listen 443 ssl http2;
    server_name uacademic.example.edu;

    root /var/www/uacademic/current/apps/web/dist;
    index index.html;

    # TLS is managed by the panel; these are the headers it does not set.
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    # The SPA loads only its own bundle, talks only to this origin, and pulls
    # no third-party script. `connect-src` also allows the Microsoft login
    # endpoints, which MSAL contacts from the browser.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://login.microsoftonline.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    client_max_body_size 30m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Hashed assets never change under the same name: cache them for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The shell and the worker must not be: a cached index.html or sw.js is
    # how a browser gets stuck on last month's version.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events: no buffering, no early timeout. This is how the
        # assistant streams and how realtime updates arrive where WebSockets
        # are not available.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # Everything else is the SPA's own routing.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The uploads directory lives outside the webroot and is served only by the
    # API, after the role and the tenant have been checked. Nothing here should
    # ever expose it — this block exists to make that explicit.
    location /shared/ {
        deny all;
        return 404;
    }
}
