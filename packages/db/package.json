{
  "name": "@uacademic/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx seed/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "@uacademic/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@uacademic/tsconfig": "workspace:*",
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
