enum ChangeRequestStatus {
  draft
  requested
  accepted_by_teacher
  approved_by_coordinator
  applied
  rejected
  cancelled
  expired
}

enum AbsenceType {
  sick_leave
  personal_leave
  conference
  training
  other
}

enum AbsenceStatus {
  requested
  approved
  rejected
  cancelled
}

enum ConversationType {
  direct
  group
  subject
  announcement
}

enum CalendarProvider {
  microsoft
  google
}

enum SyncDirection {
  push
  pull
  both
}

enum ConnectionStatus {
  active
  expired
  revoked
  error
}

enum BusySlotSource {
  microsoft
  google
  manual
}

enum AiRole {
  user
  assistant
}

enum ProposalStatus {
  pending
  confirmed
  rejected
  expired
  failed
}

enum DocumentScope {
  university
  center
  degree
  subject
}

enum DocumentType {
  regulation
  teaching_plan
  agreement
  guide
  minutes
  other
}

enum DocumentVisibility {
  public
  center
  coordinators
  admins
