}

enum DocumentStatus {
  uploaded
  processing
  indexed
  failed
  archived
}

enum SettingsSource {
  manual
  ai_extraction
}

enum ExtractionConfidence {
  high
  medium
  low
}

enum ExtractionStatus {
  pending
  accepted
  edited
  rejected
  not_found
}

