{
  "name": "@uacademic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/jobs/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/jobs/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "jobs:tick": "node dist/jobs/tick.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "^10.1.3",
    "@uacademic/db": "workspace:*",
    "@uacademic/shared": "workspace:*",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.0",
    "hash-wasm": "4.12.0",
    "jose": "6.2.9",
    "mammoth": "1.12.1",
    "mjml": "4.16.1",
    "nodemailer": "7.0.10",
    "otpauth": "9.5.1",
    "pdfkit": "0.17.2",
    "pino": "10.3.1",
    "unpdf": "1.8.1",
    "web-push": "3.6.7",
    "xlsx": "0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/mjml": "^5.0.0",
    "@types/node": "22.19.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "@uacademic/tsconfig": "workspace:*",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
