{
  "name": "@uacademic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/jobs/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/jobs/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@uacademic/db": "workspace:*",
    "@uacademic/shared": "workspace:*",
    "dotenv": "17.4.2",
    "fastify": "5.12.0",
    "pino": "10.3.1",
    "zod": "4.4.3",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.1",
    "csv-parse": "7.0.2",
    "exceljs": "4.4.0",
    "hash-wasm": "4.12.0",
    "jose": "6.2.9",
    "otpauth": "9.5.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@uacademic/tsconfig": "workspace:*",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
