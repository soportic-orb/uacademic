# UAcademic — environment configuration
#
# Copy to `.env` at the repository root (and to apps/api/.env and
# packages/db/.env, which read the same values) and fill it in.
# R10: nothing here that is a secret ever gets committed.
#
# Every name carries the `UACADEMIC_` prefix (the browser build uses
# `VITE_UACADEMIC_`), and the application reads *only* prefixed names. The
# target hosting is a shared Plesk or CloudPanel server where several
# applications share one environment: a bare `SMTP_HOST`, `DATABASE_URL` or
# `GOOGLE_CLIENT_ID` may well belong to a neighbour, and UAcademic must never
# pick it up. `NODE_ENV` is the one exception — it is Node's, not ours.

# ─────────────────────────────────────────────────────────────────────────────
# Database — MySQL 8, utf8mb4_unicode_ci, InnoDB
# ─────────────────────────────────────────────────────────────────────────────
UACADEMIC_DATABASE_URL="mysql://uacademic:change-me@127.0.0.1:3306/uacademic"

# A scratch database Prisma uses to detect drift when creating migrations.
# Only needed in development; `prisma migrate deploy` in production does not.
UACADEMIC_SHADOW_DATABASE_URL="mysql://uacademic:change-me@127.0.0.1:3306/uacademic_shadow"

# ─────────────────────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
UACADEMIC_HOST="0.0.0.0"
UACADEMIC_PORT="3001"
UACADEMIC_LOG_LEVEL="info"

# Comma-separated list of browser origins allowed to call the API.
UACADEMIC_WEB_ORIGIN="http://localhost:5173"

# AES-256-GCM key for the calendar tokens stored in the database.
# 32 bytes, hex-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for calendar connections: the provider access and refresh tokens are
# AES-256-GCM encrypted with it. Generate with `openssl rand -hex 32`.
UACADEMIC_APP_ENCRYPTION_KEY=""

# Rate limiting
UACADEMIC_RATE_LIMIT_MAX="300"
UACADEMIC_RATE_LIMIT_WINDOW_MS="60000"

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────
# `entra` is the real thing. `mock` keeps the header identity for local
# development and the e2e suite, and the API refuses it in production.
UACADEMIC_AUTH_MODE="entra"
UACADEMIC_MOCK_USER_EMAIL="marta.puig@demo.uacademic.test"

# Microsoft Entra ID. The app is registered as multi-tenant, so the JWKS below
# signs tokens for every Microsoft organization: what makes a token ours is the
# `tid` matching a tenant registered in `entra_tenants` (R3).
UACADEMIC_ENTRA_CLIENT_ID=""
UACADEMIC_ENTRA_JWKS_URI="https://login.microsoftonline.com/organizations/discovery/v2.0/keys"
# Extra accepted audiences, comma separated (e.g. api://<client-id>).
UACADEMIC_ENTRA_EXTRA_AUDIENCES=""

# Server-side sessions. The browser only holds an httpOnly, signed cookie.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UACADEMIC_SESSION_COOKIE_SECRET=""
UACADEMIC_SESSION_TTL_HOURS="8"
# Leave unset outside production; `true` requires HTTPS.
UACADEMIC_SESSION_COOKIE_SECURE=""

# Break-glass superadmin credential created by the seed.
UACADEMIC_SEED_SUPERADMIN_PASSWORD="Superadmin-2026-demo"

# Where the SPA is served from: notification links point here.
UACADEMIC_APP_URL="http://localhost:5173"

# Message attachments are written to disk (no object storage on the target host).
UACADEMIC_UPLOAD_DIR="./var/uploads"

# Bulk import limits
UACADEMIC_IMPORT_MAX_ROWS="5000"
UACADEMIC_IMPORT_MAX_FILE_MB="5"

# ─────────────────────────────────────────────────────────────────────────────
# Job queue — a MySQL table polled by a worker. There is no Redis in production.
# ─────────────────────────────────────────────────────────────────────────────
UACADEMIC_JOB_POLL_INTERVAL_MS="5000"
UACADEMIC_JOB_BATCH_SIZE="5"

# ─────────────────────────────────────────────────────────────────────────────
# Email (Nodemailer + MJML templates) — phase 4
# ─────────────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty in development: the mailer then logs the email it
# would have sent instead of refusing to work.
UACADEMIC_SMTP_HOST=""
UACADEMIC_SMTP_PORT="587"
UACADEMIC_SMTP_SECURE="false"
UACADEMIC_SMTP_USER=""
UACADEMIC_SMTP_PASSWORD=""
UACADEMIC_SMTP_FROM="UAcademic <no-reply@example.edu>"

# ─────────────────────────────────────────────────────────────────────────────
# Web push (VAPID) — phase 4. Generate with `npx web-push generate-vapid-keys`.
# Without these, push is reported as unavailable and nothing is queued.
# ─────────────────────────────────────────────────────────────────────────────
UACADEMIC_VAPID_PUBLIC_KEY=""
UACADEMIC_VAPID_PRIVATE_KEY=""
UACADEMIC_VAPID_SUBJECT="mailto:admin@example.edu"

# ── Calendar connections (phase 4B) ────────────────────────────────────────────
# Public address of this API. It builds the OAuth redirect URIs and the ICS
# subscription URL, so it must match what is registered with each provider.
UACADEMIC_API_PUBLIC_URL="http://localhost:3001"

# Microsoft Graph. The sign-in is a public-client flow and needs no secret; this
# one is only for the calendar consent, which is asked for separately.
UACADEMIC_ENTRA_CLIENT_SECRET=""
UACADEMIC_ENTRA_AUTHORITY_TENANT="organizations"

# Google Calendar. Verification takes weeks — see the README before enabling.
# Redirect URI: <API_PUBLIC_URL>/api/v1/calendar/connections/google/callback
UACADEMIC_GOOGLE_CLIENT_ID=""
UACADEMIC_GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# AI assistant and OTA updates — server-side only, never exposed to the client
# ─────────────────────────────────────────────────────────────────────────────
UACADEMIC_ANTHROPIC_API_KEY=""
UACADEMIC_GITHUB_OTA_TOKEN=""
UACADEMIC_GITHUB_OTA_REPO="soportic-orb/uacademic"

# ─────────────────────────────────────────────────────────────────────────────
# Web app (Vite). Only VITE_-prefixed values reach the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────
VITE_UACADEMIC_API_URL="http://localhost:3001"
# MSAL: same client id as the API, no secret — the SPA uses PKCE.
VITE_UACADEMIC_ENTRA_CLIENT_ID=""
VITE_UACADEMIC_ENTRA_AUTHORITY="https://login.microsoftonline.com/organizations"
# `mock` shows the demo identity switcher. Never set it in a real deployment.
VITE_UACADEMIC_AUTH_MODE=
